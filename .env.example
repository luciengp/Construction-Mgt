# Supabase project (dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only secret key (same page, "service_role" / secret). Never shipped
# to the browser. Required for sign-up, PIN login, admin member management,
# seeding, and the DB test suite.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only pepper for hashing 6-digit site-engineer PINs. Any long random
# string; keep it stable (rotating it invalidates every stored PIN).
PIN_PEPPER=

# Public origin used to build magic-link callback URLs (optional in dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
